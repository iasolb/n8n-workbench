# Copy to .env and fill in. .env is gitignored and must stay that way.
# ./setup.sh writes this file for you and generates the key.

# Compose project name. Keep it `n8n` so the container is `n8n-n8n-1`, which is
# the name the docs, the workflows and tools/ already refer to.
COMPOSE_PROJECT_NAME=n8n

# Pin a version rather than tracking latest, so two machines run the same n8n.
# The Mac pulled 2.36.9 on 2026-09-01; match it on other machines.
# Keep values on their own line: setup.sh copies this file to .env, and compose
# would read a trailing `# comment` as part of the value.
N8N_VERSION=2.36.9

# Protects the stored credential blobs. Generate with:
#   openssl rand -hex 32
# LOSING THIS LOSES EVERY STORED CREDENTIAL in the data volume. It is not
# recoverable from the volume alone. Back it up somewhere real.
# It is also what would let a second machine read a copied volume, so it is a
# secret in the strong sense: never commit it, never paste it into a chat.
N8N_ENCRYPTION_KEY=

# Where the memory bank is checked out on this machine. The default is the
# sibling directory, which is correct when this repo sits inside ai-kit.
MEMORY_BANK=../ai-memory-bank

TZ=America/New_York

# The mailbox the gmail workflows target. Public workflow JSON references it
# as $env.MAIL_ACCOUNT and never carries the address inline. Required: an
# unset value resolves to undefined and the workflow silently targets nothing.
MAIL_ACCOUNT=
